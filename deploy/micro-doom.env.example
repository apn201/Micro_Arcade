# Configuration for the micro-doom service, installed to /etc/micro-doom.env.
# Every MD_* variable mirrors a command-line option of service/run.py; run
# `python3 service/run.py --help` to see them all. Restart after editing:
#
#     sudo systemctl restart micro-doom
#
# Values here are the defaults, so an unedited file changes nothing.

# --- network --------------------------------------------------------------
MD_BIND=0.0.0.0
MD_PORT=20002

# A shared secret the terminal must send. Empty means no authentication, which
# is acceptable only on a trusted LAN. Set the same string in the device's
# client/config.py as TOKEN.
MD_TOKEN=

# How long to wait for the terminal to acknowledge an update before sending
# anyway, in ms. This is the length of the freeze after a lost packet. 0 adapts
# to the measured round trip, which is almost always what you want.
MD_ACK_TIMEOUT=0

# Milliseconds between the fragments of one update. The AtomS3R's socket holds
# a single datagram, so two sent back to back means the second is dropped and
# the update never completes. 0 sends them as fast as possible.
MD_FRAG_GAP=3

# --- game -----------------------------------------------------------------
# doom = headless DOOM. test = a test pattern that draws the live
# accelerometer values on screen, which is how the tilt controls get calibrated.
MD_SOURCE=doom
MD_WARP=1 1
MD_SKILL=3

# --- video ----------------------------------------------------------------
MD_SIZE=128x128
MD_FPS=20
MD_QUALITY=55

# Dirty-rectangle granularity in pixels; 0 sends the whole frame every time.
MD_TILE=32

# --- controls -------------------------------------------------------------
# Accelerometer axis for turning and for forward/back, with a trailing - to
# invert. These defaults were measured on an AtomS3R held screen-up.
MD_TILT_TURN=x-
MD_TILT_MOVE=y-

# Milli-g of tilt before it counts.
MD_DEADZONE=180

# Milli-g of tilt that also holds RUN; 0 disables running. Full tilt measures
# about 700, so a threshold much below ~600 turns every committed lean into a
# sprint -- which mostly means running into walls.
MD_RUN=0

# Accelerometer smoothing, 0-1. A hand shakes faster than the 30Hz sample rate,
# and that noise crosses the deadzone repeatedly unless it is filtered. Lower
# is smoother but slower to respond; 0 disables.
MD_SMOOTH=0.4

# --- diagnostics ----------------------------------------------------------
# Leave off in normal use: it prints 30 lines a second, and writing them blocks
# the service's single loop.
MD_DEBUG_INPUT=0

# Log key presses and releases with the tilt values behind them. A few lines a
# second, so this one is safe to leave on while playing -- it is the tool for
# "why did it turn when I did not mean it to".
MD_DEBUG_KEYS=0
